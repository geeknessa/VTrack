# VTrack Backend Production Environment Configuration
NODE_ENV=production
PORT=5000

# PostgreSQL Connection String (Neon, Supabase, Render Postgres, etc.)
# IMPORTANT: Append sslmode=require for managed cloud database providers
DATABASE_URL=postgres://user:password@ep-example-pooler.us-east-2.aws.neon.tech/vtrack?sslmode=require

# Secure Random 64-character session signing secret.
# You can generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_cryptographically_secure_random_64_char_secret_key

# Frontend Deployed Client URL (for CORS and Secure Cookie headers)
# Support comma-separated origins if using multiple domains
CLIENT_URL=https://vtrack.vercel.app
ALLOWED_ORIGINS=https://vtrack.vercel.app
